<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    
    <!-- PACKAGE_USAGE_STATS: Required for UsageStatsManager to detect foreground apps -->
    <!-- This is a special permission that requires the user to grant access through Settings -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    
    <!-- SYSTEM_ALERT_WINDOW: Required to display overlay on top of other apps -->
    <!-- This permission allows the app to draw over other apps -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    
    <!-- FOREGROUND_SERVICE: Required to run a long-running service in the foreground -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    
    <!-- FOREGROUND_SERVICE_SPECIAL_USE: For Android 14+ when using foreground service for app monitoring -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    
    <!-- RECEIVE_BOOT_COMPLETED: Required to restart the blocking service after device reboot -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    
    <!-- QUERY_ALL_PACKAGES: Required to query installed packages (Android 11+) -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    
    <!-- POST_NOTIFICATIONS: Required for Android 13+ to show notifications -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    
    <application>
        
        <!-- Main Blocker Service -->
        <service
            android:name="expo.modules.appblockerengine.blocker.service.BlockerService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="appBlocking" />
        </service>
        
        <!-- Boot Receiver to restart service after device reboot -->
        <receiver
            android:name="expo.modules.appblockerengine.blocker.receiver.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <!-- For HTC devices -->
                <action android:name="android.intent.action.ACTION_BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
        
    </application>
    
</manifest>
